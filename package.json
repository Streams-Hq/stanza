{
  "name": "stanza",
  "version": "0.1.0",
  "private": true,
  "description": "Stanza — non-custodial recurring subscriptions on Stellar Soroban",
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "contract:build": "stellar contract build --manifest-path contracts/stanza/Cargo.toml",
    "contract:test": "cd contracts/stanza && cargo test",
    "contract:fmt": "cd contracts/stanza && cargo fmt --check",
    "deploy:testnet": "node scripts/deploy-testnet.mjs",
    "docs:serve": "mkdocs serve",
    "docs:build": "mkdocs build --strict"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20.0.0"
  }
}
